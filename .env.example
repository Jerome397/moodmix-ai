# Baseline mode works without credentials. Never commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative provider; automatic switching is disabled.
OPENAI_API_KEY=
# Set to a model available to your account that supports Structured Outputs.
OPENAI_MODEL=
MOODMIX_API_URL=http://127.0.0.1:8000
